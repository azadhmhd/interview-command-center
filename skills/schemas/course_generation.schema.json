{
  "$id": "icc/course_generation",
  "title": "course_generation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectations": {
      "type": "string",
      "maxLength": 4000
    },
    "competencies": {
      "default": [],
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "topicChecklist": {
      "default": [],
      "maxItems": 25,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "title",
          "priority",
          "reason"
        ]
      }
    },
    "lessons": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,60}$",
            "description": "stable slug; reuse existing keys to update a lesson"
          },
          "kind": {
            "type": "string",
            "enum": [
              "concept",
              "coding",
              "system_design",
              "behavioral",
              "flashcards",
              "mock",
              "revision",
              "recruiter",
              "take_home"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "objectives": {
            "default": [],
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "estimatedMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 480
          },
          "explanation": {
            "type": "string",
            "minLength": 20,
            "maxLength": 30000,
            "description": "Markdown. Tailored to the candidate's background."
          },
          "examples": {
            "type": "string",
            "maxLength": 30000
          },
          "questions": {
            "default": [],
            "maxItems": 25,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 4000
                },
                "modelAnswer": {
                  "type": "string",
                  "maxLength": 20000
                },
                "followUps": {
                  "default": [],
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "source": {
                  "default": "PRACTICE",
                  "description": "AI_PREDICTED = you predict it may be asked; PRACTICE = exercise; PUBLIC_REPORT = only with a cited public source",
                  "type": "string",
                  "enum": [
                    "AI_PREDICTED",
                    "PRACTICE",
                    "PUBLIC_REPORT"
                  ]
                }
              },
              "required": [
                "prompt"
              ]
            }
          },
          "evaluationCriteria": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "commonMistakes": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "scheduledDay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          }
        },
        "required": [
          "key",
          "kind",
          "title",
          "estimatedMinutes",
          "explanation"
        ]
      }
    },
    "questionsToAsk": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "risks": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "finalNotes": {
      "type": "string",
      "maxLength": 20000
    },
    "assumptions": {
      "default": [],
      "description": "Uncertain claims or predictions you made, stated plainly",
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "expectations",
    "lessons"
  ]
}
