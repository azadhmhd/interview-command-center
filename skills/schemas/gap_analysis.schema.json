{
  "$id": "icc/gap_analysis",
  "title": "gap_analysis",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 5000
    },
    "weakTopics": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "recurringMistakes": {
      "default": [],
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "recommendations": {
      "default": [],
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "summary"
  ]
}
