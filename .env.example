# ---- Core ----
DATABASE_URL=postgresql://icc:icc@localhost:5434/icc
REDIS_URL=redis://localhost:6380
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
APP_NAME=Interview Command Center
APP_URL=http://localhost:3000
API_PORT=4000
# Set true when served over HTTPS
COOKIE_SECURE=false
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
# Directory where agent task packages are written and outputs are read back
AGENT_WORKSPACE_DIR=../../agent-workspace/tasks
# Optional: password-reset emails. Without it, reset links are written to the API log.
SMTP_URL=
MAIL_FROM=icc@localhost

# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_ENABLED=false
# e.g. http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio), http://localhost:8000/v1 (vLLM)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_DEFAULT_TEMPERATURE=0.2
# Optional model override for answer evaluation (same endpoint)
LLM_EVALUATION_MODEL=
# false on shared/hosted deployments: blocks LLM base URLs that resolve to private/loopback addresses (SSRF)
LLM_ALLOW_PRIVATE_NETWORK=true
# true = operator consents to sending interview data to a NON-local env-configured endpoint
LLM_EXTERNAL_DATA_CONSENT=false

# ---- Optional unattended agent: Claude Code headless mode (host only, off by default) ----
AGENT_CLAUDE_CLI_ENABLED=false
AGENT_CLAUDE_CLI_PATH=claude
AGENT_CLAUDE_CLI_TIMEOUT_MS=900000
# Docker: the worker container logs in with this. Generate on the host with `claude setup-token` (uses your subscription).
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Scheduler ----
SCHEDULER_TICK_MS=30000
WORKER_CONCURRENCY=2

# ---- Development seed (pnpm db:seed) — local only ----
SEED_DEMO_EMAIL=demo@icc.test
SEED_DEMO_PASSWORD=demo-password-123
